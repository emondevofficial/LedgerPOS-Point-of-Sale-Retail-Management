# Server & Application URL
APP_URL="http://localhost:3000"
NODE_ENV="development"
PORT=3000

# MongoDB Connection String (Leave empty to use persistent local file-backed database in .data/)
MONGODB_URI=

# Security: HMAC secret for signing session tokens (falls back to secure runtime random key if unset)
SESSION_SECRET=

# Optional Admin Bootstrap Passcode (if set, overrides/locks first-run setup claim)
ADMIN_BOOTSTRAP_CODE=
